# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Each secret is a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The four API_SECRET_* values must match the Make team variables
# secret_shop_intake, secret_below_target_alert, secret_approval_routing
# and secret_report_draft.

# Signs the session cookie; without it you are signed out on every restart.
SECRET_KEY=
# Optional: defaults to marketingops_v2.db in the repo folder.
DATABASE_PATH=

# One secret per automation (spec v2 section 8).
API_SECRET_SHOP_INTAKE=
API_SECRET_BELOW_TARGET_ALERT=
API_SECRET_APPROVAL_ROUTING=
API_SECRET_REPORT_DRAFT=

# Where the app announces events, and the key that signs those announcements.
MAKE_WEBHOOK_DATA_LOADED=
MAKE_WEBHOOK_ACTIONS=
OUTBOX_SECRET=
